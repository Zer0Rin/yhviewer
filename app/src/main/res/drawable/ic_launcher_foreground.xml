<?xml version="1.0" encoding="utf-8"?>
<!--
  YHViewer 图标 A：杏仁形眼睛，V 从下方升起、两臂碰到上眼睑。
  108dp 自适应图标画布；图形放大 1.12 倍后仍在 66dp 安全圆内（只有眼角尖略贴边）。
  颜色：眼睛 #F0EEE6，V #D97757。
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <group
        android:pivotX="54"
        android:pivotY="54"
        android:scaleX="1.12"
        android:scaleY="1.12">
        <!-- 眼睛轮廓：上下两条二次曲线 -->
        <path
            android:pathData="M27,54 Q54,30 81,54 Q54,78 27,54 Z"
            android:strokeColor="#F0EEE6"
            android:strokeWidth="4.5"
            android:strokeLineJoin="round" />
        <!-- 字母 V：两臂的圆头和上眼睑重叠，连成一体 -->
        <path
            android:pathData="M43,45 L54,63 L65,45"
            android:strokeColor="#D97757"
            android:strokeWidth="5"
            android:strokeLineCap="round"
            android:strokeLineJoin="round" />
    </group>
</vector>
